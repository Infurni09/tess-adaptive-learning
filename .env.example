# Database Connection (from Replit PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
PGHOST=your-neon-hostname
PGPORT=5432
PGUSER=your-db-user
PGPASSWORD=your-db-password
PGDATABASE=your-database-name

# Session Management
SESSION_SECRET=your-session-secret-here-minimum-32-characters

# Environment
NODE_ENV=development

# Optional: Replit Auth (if using OAuth)
# These are handled by Replit automatically when using Replit Auth integration
